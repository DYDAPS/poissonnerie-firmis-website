msgstr "(all REST API endpoints)"

msgid "(all WordPress v2 content endpoints)"
msgstr "(all WordPress v2 content endpoints)"

msgid "included by parent"
msgstr "included by parent"

msgid "Additional custom prefixes"
msgstr "Additional custom prefixes"

msgid "Add one REST route prefix per line, for example /wc/v3/ or /my-plugin/v1/. Invalid or empty lines are ignored."
msgstr "Add one REST route prefix per line, for example /wc/v3/ or /my-plugin/v1/. Invalid or empty lines are ignored."

msgid "Add one REST URL or route prefix per line that must stay public, even when full blocking is enabled or when it falls under a protected parent route."
msgstr "Add one REST URL or route prefix per line that must stay public, even when full blocking is enabled or when it falls under a protected parent route."

