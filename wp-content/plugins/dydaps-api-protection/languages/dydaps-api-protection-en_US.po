msgid "DYDAPS API Protection"
msgstr "DYDAPS API Protection"

msgid "Settings"
msgstr "Settings"

msgid "Protect selected WordPress REST API routes with a secret API key sent in a custom HTTP header."
msgstr "Protect selected WordPress REST API routes with a secret API key sent in a custom HTTP header."

msgid "A valid API key is required to access this endpoint."
msgstr "A valid API key is required to access this endpoint."

msgid "This REST API endpoint is blocked."
msgstr "This REST API endpoint is blocked."

msgid "Copied"
msgstr "Copied"

msgid "Protect selected WordPress REST API routes by requiring a secret API key in the X-DYDAPS-API-Key header."
msgstr "Protect selected WordPress REST API routes by requiring a secret API key in the X-DYDAPS-API-Key header."

msgid "Full blocking is enabled: public exceptions stay open, selected routes require the API key, and all other REST routes are blocked."
msgstr "Full blocking is enabled: public exceptions stay open, selected routes require the API key, and all other REST routes are blocked."

msgid "Only selected routes require the API key. Other REST API routes remain public unless you enable full blocking."
msgstr "Only selected routes require the API key. Other REST API routes remain public unless you enable full blocking."

msgid "Protected routes"
msgstr "Protected routes"

msgid "Public exceptions"
msgstr "Public exceptions"

msgid "Your new API key is shown only once."
msgstr "Your new API key is shown only once."

msgid "Copy it now and store it securely. The plain key is never stored and cannot be retrieved later."
msgstr "Copy it now and store it securely. The plain key is never stored and cannot be retrieved later."

